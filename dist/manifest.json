{
  "manifest_version": 3,
  "name": "ForeCode - LC Contest Rating Predictor",
  "version": "0.1.0",
  "description": "Predicts your LeetCode rating immediately after a contest.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "ForeCode - LC Contest Rating Predictor"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/contest/*", "https://leetcode.cn/contest/*"],
      "js": ["scripts/content.js"]
    },
    {
      "matches": ["https://leetcode.com/u/*"],
      "js": ["scripts/profileInjector.js"]
    }
  ]
}
